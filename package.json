{
  "name": "arc-maze",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A maze on Arc that charges by the step, and pays out reputation.",
  "scripts": {
    "start": "bun run server.ts",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p cre/verdict/tsconfig.json --noEmit",
    "gate": "bun run typecheck && bun run test && bun run test:contracts && bun run test:workflow",
    "test:contracts": "cd contracts && FOUNDRY_DISABLE_NIGHTLY_WARNING=1 forge test",
    "test:workflow": "bun test --cwd ./cre/verdict"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
