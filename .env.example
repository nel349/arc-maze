# Copy to .env and fill in. Bun loads .env from the working directory on its own, so
# `bun run start` picks these up with no flag and no dotenv import.
#
# Only SELLER_ADDRESS is required. Everything else turns a feature on, and the maze runs
# without any of it — it simply plays without paying anything out.

# --- required ---

# Where payments land. Refused rather than defaulted at startup: a seller quietly paying a
# placeholder collects nothing and finds out from an empty balance a week later.
SELLER_ADDRESS=0xYourPayeeAddress

# --- optional: the reputation and badge half ---

# Two keys, because the jobs need different permissions and NEITHER OF THEM OWNS ANYTHING.
#
# Signs feedback into Arc's registry. Needs no on-chain privilege at all — anybody may write
# feedback about an agent that is not their own — so it holds gas and nothing else.
# MAZE_REPUTATION_KEY=0x...

# The one address the badge contract allows to mint, and the contract allows it nothing else: it
# cannot move the metadata, appoint a different minter, or transfer the contract.
# MAZE_ADMITTER_KEY=0x...

# There is no third key here on purpose. The key that *owns* the badge deployed it from a laptop
# and stays there; nothing this server does needs it. `MAZE_PRIVATE_KEY` was its old name, back
# when one key did both jobs, and setting it now makes the server refuse to start rather than run
# with a key that could mint the whole cohort.

# The Cohort 0 badge, live on Arc testnet. Omit it and runs still earn reputation, just no badge.
# Reading how full the cohort is takes no key, so the front page keeps its count either way.
BADGE_CONTRACT=0xc360e1229b83a1a23080a28e57a0949e25cf4e7f

# Where this maze answers from, quoted inside every reputation record — permanently.
#
# Leave it unset for local play. Setting it to a tunnel hostname is deliberately not enough:
# a record citing a name that dies tomorrow is a permanent claim pointing at nothing, so the
# maze refuses to write from one unless ALLOW_EPHEMERAL_URL says you mean it.
# PUBLIC_URL=https://maze.example.com
# ALLOW_EPHEMERAL_URL=true

# --- optional: where records outlive this process ---

# Both halves or neither. Without them a record lives as long as this server, which is right on a
# laptop and wrong the moment a reputation record on chain quotes one of its URLs for ever.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# --- optional: the rest ---

# PORT=8790
# ARC_RPC_URL=https://rpc.testnet.arc.network
# GATEWAY_API=https://gateway-api-testnet.circle.com     # mainnet is the thing you opt into
# FIRST_ROUND=2026-09-01T00
